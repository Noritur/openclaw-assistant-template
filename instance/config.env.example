# Copy to instance/config.env inside a private repository and replace every
# placeholder. Never put API keys or bot tokens in this file.

ASSISTANT_ID=your-assistant
ASSISTANT_NAME=your-assistant
OWNER_NAME=YourName

SERVER_IP=YOUR_SERVER_IP
# Public host key of the server. The value contains a space, so it must stay
# quoted: this file is sourced as shell.
# Read it with: ssh-keyscan -t ed25519 YOUR_SERVER_IP
# Leave empty only if you accept trust-on-first-use for every connection.
SERVER_SSH_HOST_KEY=''
ADMIN_SSH_USER=root
SSH_USER=assistant
SSH_KEY_NAME=id_ed25519_openclaw
BOT_USER=assistant

TELEGRAM_USER_ID=YOUR_NUMERIC_TELEGRAM_ID

MEMORY_REPO_SSH=git@github.com:YOUR_GITHUB_USER/YOUR_MEMORY_REPO.git
MEMORY_REPO_SLUG=YOUR_GITHUB_USER/YOUR_MEMORY_REPO
INFRA_REPO_SLUG=YOUR_GITHUB_USER/YOUR_PRIVATE_INFRA_REPO

OPENCLAW_NPM_PACKAGE=openclaw
OPENCLAW_VERSION=2026.6.8
NODE_MAJOR=24
CLAWD_WORKSPACE=/home/assistant/clawd

RAW_MEMORY_CONSENT=no
ENABLE_GITHUB_MCP=no
ENABLE_TAILDRIVE=no
TAILDRIVE_TAILNET=
TAILDRIVE_DEVICE=
TAILDRIVE_SHARE=
